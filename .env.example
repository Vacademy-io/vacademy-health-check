# Internal-auth credentials for GET /admin-core-service/internal/ai-queue/snapshot,
# used by the Call queue tab. Validated against client_secret_key by InternalAuthFilter.
#
# These are deliberately NOT prefixed with VITE_: anything VITE_-prefixed is compiled
# into the JS the browser downloads, which would publish the shared secret. They are
# read by the dev proxy in vite.config.ts and, when deployed, by the Cloudflare Pages
# function in functions/[[route]].ts — both server-side, so the secret never ships.
#
# Copy to .env.local for local development. In production set the same two names as
# Pages environment variables.
AI_QUEUE_CLIENT_NAME=
AI_QUEUE_SIGNATURE=
